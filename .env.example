# Copy this file to .env and fill in your keys.
# The OpenAI key is NOT in here — it's entered in Vane's setup screen at http://localhost:3000.

# Semantic Scholar API key — needed for higher rate limits on the /papers and /graph endpoints.
# Without a key you get ~100 req/5min; with one you get ~100 req/sec.
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex polite-pool email (recommended). Adds a `mailto` param that puts you
# in the 100k req/day pool instead of the slower anonymous pool.
OPENALEX_EMAIL=

# CrossRef polite-pool email. Same idea as OpenAlex.
CROSSREF_EMAIL=

# NCBI E-utilities API key — lets us call PubMed at 10 req/sec instead of 3.
PUBMED_API_KEY=
