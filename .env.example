# Copy this file to .env and fill in the keys you have.
# This file is the DEPLOYMENT CONTROL PANEL — every switch lives here.
# docker compose auto-configures Vane with the LLM keys on startup.

# ============================================================
# LLM control panel
# ============================================================
# Master switch: which provider serves ALL LLM traffic (chat, gap analysis,
# citation-intent classification). Switch any time:
#   1. edit LLM_PROVIDER below
#   2. docker compose up -d research-api web
#
#   openai  -> the good/paid model (use for important demos)
#   groq    -> free tier (use day-to-day)
LLM_PROVIDER=openai

# OpenAI API key. Get one at https://platform.openai.com/api-keys
# Also used for embeddings even when groq is active (Groq has no embedding
# models; embedding cost is negligible).
OPENAI_API_KEY=

# Groq API key (free). Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional model overrides (sensible defaults are used when empty).
OPENAI_MODEL=
GROQ_MODEL=

# ============================================================
# Deployment URLs
# ============================================================
# Where the BROWSER reaches Vane and the research API. Leave empty for local
# use (defaults to http://localhost:3002 / http://localhost:8000). When
# deploying on a server, set to the public address and rebuild the web image:
#   NEXT_PUBLIC_VANE_URL=http://<server-ip-or-domain>:3002
#   NEXT_PUBLIC_RESEARCH_API_URL=http://<server-ip-or-domain>:8000
#   docker compose up -d --build web
NEXT_PUBLIC_VANE_URL=
NEXT_PUBLIC_RESEARCH_API_URL=

# ============================================================
# Paper-source keys (optional but improve rate limits)
# ============================================================

# Semantic Scholar API key (optional). Get one at https://www.semanticscholar.org/product/api
# Without a key you still get ~100 req/5min; with a key you get much higher limits.
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex polite-pool email (optional but recommended).
# Including this gives you 100k requests/day vs the slower anonymous pool.
OPENALEX_EMAIL=

# CrossRef polite-pool email (optional but recommended).
CROSSREF_EMAIL=

# PubMed (NCBI) API key (optional). Get one at https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-for-the-e-utilities/
PUBMED_API_KEY=
